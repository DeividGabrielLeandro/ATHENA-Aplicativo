<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ATHENA.CriarCategoria"
    BackgroundColor="{StaticResource AthenaBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="True">

    <ScrollView>

        <VerticalStackLayout
            Padding="16,16,16,32"
            Spacing="20">

            <!-- CABEÇALHO: mesmo padrão da criação de meta, sem foto de perfil -->
            <Grid
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="8">

                <Button
                    Grid.Column="0"
                    Text="‹"
                    Clicked="Voltar_Clicked"
                    WidthRequest="40"
                    HeightRequest="40"
                    MinimumWidthRequest="40"
                    MinimumHeightRequest="40"
                    Padding="0"
                    CornerRadius="10"
                    FontSize="32"
                    TextColor="{StaticResource AthenaBlueLight}"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    BorderColor="{StaticResource AthenaBorder}"
                    BorderWidth="1"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    SemanticProperties.Description="Voltar" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <HorizontalStackLayout Spacing="6">

                        <Label
                            Text="ATHENA"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.8"
                            TextColor="{StaticResource AthenaGold}"
                            VerticalOptions="Center" />

                        <Label
                            Text="•"
                            FontSize="10"
                            TextColor="{StaticResource AthenaBorder}"
                            VerticalOptions="Center" />

                        <Label
                            Text="CATEGORIAS"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="0.8"
                            TextColor="{StaticResource AthenaTextMuted}"
                            VerticalOptions="Center" />

                    </HorizontalStackLayout>

                    <Label
                        Text="Nova categoria"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{StaticResource AthenaTextPrimary}" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="2"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    Stroke="{StaticResource AthenaBorderSoft}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="9,6"
                    VerticalOptions="Center">

                    <HorizontalStackLayout Spacing="6">

                        <BoxView
                            WidthRequest="6"
                            HeightRequest="6"
                            CornerRadius="3"
                            Color="{StaticResource AthenaBlue}"
                            VerticalOptions="Center" />

                        <Label
                            Text="Em criação"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AthenaTextSecondary}"
                            VerticalOptions="Center" />

                    </HorizontalStackLayout>

                </Border>

                <BoxView
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    HeightRequest="1"
                    Margin="0,14,0,0"
                    Color="{StaticResource AthenaDivider}"
                    HorizontalOptions="Fill" />

            </Grid>

            <!-- INTRODUÇÃO -->
            <VerticalStackLayout Spacing="5">

                <HorizontalStackLayout Spacing="8">

                    <Border
                        WidthRequest="30"
                        HeightRequest="30"
                        BackgroundColor="{StaticResource AthenaGoldSoft}"
                        Stroke="{StaticResource AthenaGold}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        VerticalOptions="Center">

                        <Label
                            Text="▦"
                            FontSize="18"
                            TextColor="{StaticResource AthenaGoldLight}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <Label
                        Text="ORGANIZE SEUS ESTUDOS"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8"
                        TextColor="{StaticResource AthenaGoldButton}"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

                <Label
                    Text="Crie sua categoria"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{StaticResource AthenaTextPrimary}" />

                <Label
                    Text="Agrupe suas metas por assunto e organize sua jornada de aprendizado."
                    FontSize="13"
                    LineHeight="1.3"
                    LineBreakMode="WordWrap"
                    TextColor="{StaticResource AthenaTextSecondary}" />

            </VerticalStackLayout>

            <!-- INFORMAÇÕES PRINCIPAIS -->
            <Border
                BackgroundColor="{StaticResource AthenaCard}"
                Stroke="{StaticResource AthenaBorderSoft}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="16">

                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <HorizontalStackLayout Spacing="8">

                            <BoxView
                                WidthRequest="7"
                                HeightRequest="7"
                                CornerRadius="4"
                                Color="{StaticResource AthenaBlue}"
                                VerticalOptions="Center" />

                            <Label
                                Text="INFORMAÇÕES PRINCIPAIS"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="0.8"
                                TextColor="{StaticResource AthenaTextMuted}"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="* Obrigatório"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AthenaBlueLight}"
                            VerticalOptions="Center" />

                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource AthenaDivider}" />

                    <!-- TÍTULO: nome preservado do seu C# -->
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="TÍTULO DA CATEGORIA *"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="0.5"
                            TextColor="{StaticResource AthenaTextPrimary}" />

                        <Border
                            BackgroundColor="{StaticResource AthenaSurface}"
                            Stroke="{StaticResource AthenaBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,0"
                            HeightRequest="48">

                            <Entry
                                x:Name="TituloTXT"
                                Placeholder="Ex.: Programação, Matemática..."
                                PlaceholderColor="{StaticResource AthenaTextMuted}"
                                TextColor="{StaticResource AthenaTextPrimary}"
                                BackgroundColor="Transparent"
                                FontSize="14"
                                FontAttributes="Bold"
                                MaxLength="100"
                                ClearButtonVisibility="WhileEditing"
                                VerticalOptions="Center" />

                        </Border>

                    </VerticalStackLayout>

                    <!-- DESCRIÇÃO: opcional -->
                    <VerticalStackLayout Spacing="7">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                            <Label
                                Text="DESCRIÇÃO"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="0.5"
                                TextColor="{StaticResource AthenaTextPrimary}"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                BackgroundColor="{StaticResource AthenaSurface}"
                                Stroke="{StaticResource AthenaBorderSoft}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,3">

                                <Label
                                    Text="Opcional"
                                    FontSize="10"
                                    TextColor="{StaticResource AthenaTextMuted}" />

                            </Border>

                        </Grid>

                        <Border
                            BackgroundColor="{StaticResource AthenaSurface}"
                            Stroke="{StaticResource AthenaBorderSoft}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,8"
                            MinimumHeightRequest="92">

                            <Editor
                                x:Name="DescricaoTXT"
                                Placeholder="Descreva o que você vai organizar nesta categoria..."
                                PlaceholderColor="{StaticResource AthenaTextMuted}"
                                TextColor="{StaticResource AthenaTextPrimary}"
                                BackgroundColor="Transparent"
                                FontSize="13"
                                MaxLength="500"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="76" />

                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- METAS: vinculação opcional, sem criar uma nova página -->
            <Border
                BackgroundColor="{StaticResource AthenaCard}"
                Stroke="{StaticResource AthenaBorderSoft}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="16">

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <HorizontalStackLayout Spacing="8">

                            <BoxView
                                WidthRequest="7"
                                HeightRequest="7"
                                CornerRadius="4"
                                Color="{StaticResource AthenaGold}"
                                VerticalOptions="Center" />

                            <Label
                                Text="METAS DA CATEGORIA"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="0.8"
                                TextColor="{StaticResource AthenaTextMuted}"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="Opcional"
                            FontSize="10"
                            TextColor="{StaticResource AthenaTextMuted}"
                            VerticalOptions="Center" />

                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource AthenaDivider}" />

                    <Label
                        Text="Selecione metas sem categoria para incluir agora. Você também pode criar uma categoria vazia."
                        FontSize="12"
                        TextColor="{StaticResource AthenaTextSecondary}"
                        LineBreakMode="WordWrap" />

                    <!-- Botão ocupa toda a linha, não somente a seta. -->
                    <Button
                        x:Name="BtnSelecionarMetas"
                        Text="＋  SELECIONAR METAS"
                        Clicked="BtnSelecionarMetas_Clicked"
                        HeightRequest="48"
                        CornerRadius="11"
                        Padding="12,0"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource AthenaBlueBackground}"
                        BorderColor="{StaticResource AthenaBlue}"
                        BorderWidth="1"
                        TextColor="{StaticResource AthenaBlueLight}"
                        HorizontalOptions="Fill" />

                    <!-- Atualize este texto no evento SelectionChanged. -->
                    <Label
                        x:Name="TxtMetasSelecionadas"
                        Text="Nenhuma meta selecionada"
                        FontSize="11"
                        TextColor="{StaticResource AthenaTextMuted}" />

                    <!--
                        Painel inicialmente recolhido.
                        O C# alterna ListaMetasContainer.IsVisible.
                        O Grid fornece altura limitada para a lista rolar dentro do painel.
                    -->
                    <Border
                        x:Name="ListaMetasContainer"
                        IsVisible="False"
                        BackgroundColor="{StaticResource AthenaSurface}"
                        Stroke="{StaticResource AthenaBorderSoft}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 11"
                        Padding="8">

                        <Grid
                            RowDefinitions="Auto,*"
                            RowSpacing="8"
                            HeightRequest="260">

                            <Label
                                Text="Toque na meta para marcar ou desmarcar."
                                FontSize="10"
                                TextColor="{StaticResource AthenaTextMuted}"
                                Margin="4,2,4,0"
                                LineBreakMode="WordWrap" />

                            <CollectionView
                                Grid.Row="1"
                                x:Name="ListaMetas"
                                SelectionMode="Multiple"
                                SelectionChanged="ListaMetas_SelectionChanged"
                                ItemsLayout="VerticalList"
                                VerticalScrollBarVisibility="Always">

                                <CollectionView.EmptyView>

                                    <VerticalStackLayout
                                        Padding="12,20"
                                        Spacing="6"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="Nenhuma meta disponível"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource AthenaTextPrimary}"
                                            HorizontalTextAlignment="Center" />

                                        <Label
                                            Text="Não há metas sem categoria. Você pode criar a categoria e adicionar metas depois."
                                            FontSize="11"
                                            TextColor="{StaticResource AthenaTextMuted}"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>

                                    <DataTemplate>

                                        <!--
                                            A seleção é nativa da CollectionView.
                                            Toda a área do item pode ser tocada.
                                            Não desenhamos outro quadrado junto ao título.
                                            O estado selecionado também destaca o fundo e a borda em azul.
                                        -->
                                        <Border
                                            BackgroundColor="{StaticResource AthenaCard}"
                                            Stroke="{StaticResource AthenaBorderSoft}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 9"
                                            Padding="14,10"
                                            Margin="{OnPlatform Default='0,0,0,8', WinUI='32,0,0,8'}"
                                            MinimumHeightRequest="64">

                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup Name="CommonStates">

                                                    <VisualState Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter
                                                                Property="BackgroundColor"
                                                                Value="{StaticResource AthenaCard}" />
                                                            <Setter
                                                                Property="Stroke"
                                                                Value="{StaticResource AthenaBorderSoft}" />
                                                        </VisualState.Setters>
                                                    </VisualState>

                                                    <VisualState Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter
                                                                Property="BackgroundColor"
                                                                Value="{StaticResource AthenaBlueBackground}" />
                                                            <Setter
                                                                Property="Stroke"
                                                                Value="{StaticResource AthenaBlue}" />
                                                        </VisualState.Setters>
                                                    </VisualState>

                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>

                                            <VerticalStackLayout
                                                Spacing="4"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Center"
                                                InputTransparent="True">

                                                <Label
                                                    Text="{Binding tituloMeta}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource AthenaTextPrimary}"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1" />

                                                <Label
                                                    Text="{Binding descricaoMeta, TargetNullValue='Sem descrição'}"
                                                    FontSize="11"
                                                    TextColor="{StaticResource AthenaTextSecondary}"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="2" />

                                            </VerticalStackLayout>

                                        </Border>

                                    </DataTemplate>

                                </CollectionView.ItemTemplate>

                            </CollectionView>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

            </Border>

            <!-- AÇÃO PRINCIPAL -->
            <VerticalStackLayout Spacing="8" Padding="0,0,0,4">

                <Button
                    x:Name="BtnCriarCategoria"
                    Text="＋  CRIAR CATEGORIA"
                    Clicked="Button_Clicked"
                    HeightRequest="50"
                    CornerRadius="11"
                    FontSize="14"
                    FontAttributes="Bold"
                    CharacterSpacing="0.6"
                    BackgroundColor="{StaticResource AthenaGoldButton}"
                    TextColor="{StaticResource Black}"
                    BorderWidth="0"
                    HorizontalOptions="Fill" />

                <Label
                    Text="Você poderá editar a categoria e suas metas depois."
                    FontSize="11"
                    TextColor="{StaticResource AthenaTextMuted}"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
