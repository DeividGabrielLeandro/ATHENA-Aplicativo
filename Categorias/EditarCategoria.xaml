<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ATHENA.Categorias.EditarCategoria"
    BackgroundColor="{StaticResource AthenaBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="True">
    
    <ScrollView
        VerticalScrollBarVisibility="Never">

        <VerticalStackLayout
            Padding="{OnPlatform Default='16,36,16,32', WinUI='16,16,16,32'}"
            Spacing="16">

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="8">

                <Button
                    x:Name="BtnVoltarCategoria"
                    Grid.Column="0"
                    Grid.Row="0"
                    Text="‹"
                    Clicked="BtnVoltarCategoria_Clicked"
                    WidthRequest="40"
                    HeightRequest="40"
                    MinimumWidthRequest="40"
                    MinimumHeightRequest="40"
                    Padding="0"
                    CornerRadius="10"
                    FontSize="32"
                    TextColor="{StaticResource AthenaBlueLight}"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    BorderColor="{StaticResource AthenaBorder}"
                    BorderWidth="1"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    SemanticProperties.Description="Voltar aos detalhes da categoria" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Grid.Row="0"
                    Spacing="3"
                    VerticalOptions="Start">

                    <Image
                        Source="athena_wordmark_header_styled.png"
                        WidthRequest="112"
                        HeightRequest="28"
                        Aspect="AspectFit"
                        HorizontalOptions="Start" />

                    <Label
                        Text="EDITAR CATEGORIA"
                        FontSize="9"
                        CharacterSpacing="1"
                        TextColor="{StaticResource AthenaTextSecondary}"
                        HorizontalOptions="Start"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="2"
                    Grid.Row="0"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    Stroke="{StaticResource AthenaGold}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="9,6"
                    VerticalOptions="Center">

                    <HorizontalStackLayout Spacing="6">
                        <BoxView
                            WidthRequest="6"
                            HeightRequest="6"
                            CornerRadius="3"
                            Color="{StaticResource AthenaGold}"
                            VerticalOptions="Center" />
                        <Label
                            Text="Editando"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AthenaGold}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                </Border>

                <BoxView
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    HeightRequest="1"
                    Margin="0,8,0,0"
                    Color="{StaticResource AthenaBorder}"
                    HorizontalOptions="Fill" />

            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Editar categoria"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{StaticResource AthenaTextPrimary}" />
                <Label
                    Text="Atualize o título e a descrição da sua categoria."
                    FontSize="12"
                    TextColor="{StaticResource AthenaTextSecondary}"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Border
                BackgroundColor="{StaticResource AthenaSurface}"
                Stroke="{StaticResource AthenaBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="16">

                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            Text="INFORMAÇÕES DA CATEGORIA"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="0.5"
                            TextColor="{StaticResource AthenaTextSecondary}"
                            LineBreakMode="WordWrap" />
                        <Label
                            Grid.Column="1"
                            Text="* Obrigatório"
                            FontSize="10"
                            TextColor="{StaticResource AthenaGold}"
                            VerticalOptions="Center" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource AthenaBorder}"
                        HorizontalOptions="Fill" />

                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="TÍTULO DA CATEGORIA *"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AthenaTextPrimary}" />

                        <Border
                            BackgroundColor="{StaticResource AthenaSurface}"
                            Stroke="{StaticResource AthenaBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,0"
                            MinimumHeightRequest="48">

                            <Entry
                                x:Name="TituloTXT"
                                Placeholder="Nome da categoria"
                                PlaceholderColor="{StaticResource AthenaTextMuted}"
                                TextColor="{StaticResource AthenaTextPrimary}"
                                BackgroundColor="Transparent"
                                FontSize="14"
                                ClearButtonVisibility="WhileEditing"
                                ReturnType="Next"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Título da categoria, obrigatório" />

                        </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                Text="DESCRIÇÃO"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AthenaTextPrimary}" />
                            <Label
                                Grid.Column="1"
                                Text="Opcional"
                                FontSize="10"
                                TextColor="{StaticResource AthenaTextMuted}" />
                        </Grid>

                        <Border
                            BackgroundColor="{StaticResource AthenaSurface}"
                            Stroke="{StaticResource AthenaBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,8"
                            MinimumHeightRequest="112">

                            <Editor
                                x:Name="DescricaoTXT"
                                Placeholder="Descreva os estudos que fazem parte desta categoria..."
                                PlaceholderColor="{StaticResource AthenaTextMuted}"
                                TextColor="{StaticResource AthenaTextPrimary}"
                                BackgroundColor="Transparent"
                                FontSize="13"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="92"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                SemanticProperties.Description="Descrição da categoria, opcional" />

                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <Button
                x:Name="BtnSalvarCategoria"
                Text="SALVAR ALTERAÇÕES"
                Clicked="BtnSalvarCategoria_Clicked"
                HeightRequest="48"
                MinimumHeightRequest="48"
                CornerRadius="11"
                FontSize="14"
                FontAttributes="Bold"
                CharacterSpacing="0.4"
                BackgroundColor="{StaticResource AthenaGoldButton}"
                TextColor="{StaticResource Black}"
                BorderWidth="0"
                HorizontalOptions="Fill" />

            <VerticalStackLayout Spacing="8" Margin="0,4,0,0">

                <BoxView
                    HeightRequest="1"
                    Color="{StaticResource AthenaBorder}"
                    HorizontalOptions="Fill"
                    Margin="0,0,0,8" />

                <Button
                    x:Name="BtnExcluirCategoria"
                    Text="EXCLUIR CATEGORIA"
                    Clicked="BtnExcluirCategoria_Clicked"
                    HeightRequest="46"
                    MinimumHeightRequest="46"
                    CornerRadius="10"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="0.4"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    TextColor="{StaticResource AthenaError}"
                    BorderColor="{StaticResource AthenaError}"
                    BorderWidth="1"
                    HorizontalOptions="Fill" />

                <Label
                    Text="A exclusão da categoria não pode ser desfeita."
                    FontSize="10"
                    TextColor="{StaticResource AthenaTextMuted}"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
