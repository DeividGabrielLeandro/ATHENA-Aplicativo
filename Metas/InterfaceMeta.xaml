<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ATHENA.Metas.xaml.InterfaceMeta"
    BackgroundColor="{StaticResource AthenaBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="True">

    <ScrollView>


        <VerticalStackLayout
                    x:Name="ConteudoMeta"
                    Padding="16,36,16,32"
                    Spacing="16">

            <Grid
    ColumnDefinitions="Auto,*,Auto"
    RowDefinitions="Auto,Auto"
    ColumnSpacing="10"
    RowSpacing="8">

                <Button
        Grid.Column="0"
        Grid.Row="0"
        Text="‹"
        Clicked="Voltar_Clicked"
        WidthRequest="40"
        HeightRequest="40"
        Padding="0"
        CornerRadius="10"
        FontSize="32"
        TextColor="{StaticResource AthenaBlueLight}"
        BackgroundColor="{StaticResource AthenaSurface}"
        BorderColor="{StaticResource AthenaBorder}"
        BorderWidth="1"
        HorizontalOptions="Start"
        VerticalOptions="Start" />

                <VerticalStackLayout
        Grid.Column="1"
        Grid.Row="0"
        Spacing="3"
        VerticalOptions="Start">

                    <Image
            Source="athena_wordmark_header_styled.png"
            WidthRequest="112"
            HeightRequest="28"
            Aspect="AspectFit"
            HorizontalOptions="Start" />

                    <Label
            Text="DETALHES DA META"
            FontSize="9"
            CharacterSpacing="1"
            TextColor="{StaticResource AthenaTextSecondary}"
            HorizontalOptions="Start" />

                </VerticalStackLayout>

                <Border
        Grid.Column="2"
        Grid.Row="0"
        BackgroundColor="#101F38"
        Stroke="{StaticResource AthenaBlue}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 12"
        Padding="9,6"
        VerticalOptions="Start">

                    <HorizontalStackLayout
            Spacing="6">

                        <BoxView
                WidthRequest="6"
                HeightRequest="6"
                CornerRadius="3"
                Color="{StaticResource AthenaBlue}"
                VerticalOptions="Center">

                            <BoxView.Triggers>

                                <DataTrigger
                        TargetType="BoxView"
                        Binding="{Binding status}"
                        Value="Concluida">

                                    <Setter
                            Property="Color"
                            Value="{StaticResource AthenaSuccess}" />

                                </DataTrigger>

                                <DataTrigger
                        TargetType="BoxView"
                        Binding="{Binding status}"
                        Value="Concluído">

                                    <Setter
                            Property="Color"
                            Value="{StaticResource AthenaSuccess}" />

                                </DataTrigger>

                            </BoxView.Triggers>

                        </BoxView>

                        <Label
                Text="{Binding status}"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource AthenaBlueLight}"
                VerticalOptions="Center" />

                    </HorizontalStackLayout>

                </Border>

                <BoxView
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        HeightRequest="1"
                        Margin="0,14,0,0"
                        Color="#24344B"
                        HorizontalOptions="Fill" />

            </Grid>


            <Border
                        BackgroundColor="#0D1726"
                        Stroke="#1B2A40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="0">

                <Grid
                            ColumnDefinitions="4,*"
                            ColumnSpacing="0">

                    <BoxView
                                Grid.Column="0"
                                Color="{StaticResource AthenaGold}"
                                CornerRadius="2"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />

                    <VerticalStackLayout
                                Grid.Column="1"
                                Padding="16"
                                Spacing="12">

                        <HorizontalStackLayout
                                    Spacing="8">

                            <Label
                                        Text="◎"
                                        FontSize="20"
                                        TextColor="{StaticResource AthenaGold}"
                                        VerticalOptions="Center" />

                            <Label
                                        Text="META DE ESTUDO"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CharacterSpacing="0.8"
                                        TextColor="{StaticResource AthenaGold}"
                                        VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <Label
                                    Text="{Binding tituloMeta}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AthenaTextPrimary}"
                                    LineBreakMode="WordWrap"
                                    MaxLines="3" />

                        <Label
                                    Text="{Binding descricaoMeta, TargetNullValue=Sem descrição, FallbackValue=Sem descrição}"
                                    FontSize="14"
                                    LineHeight="1.25"
                                    TextColor="{StaticResource AthenaTextSecondary}"
                                    LineBreakMode="WordWrap"
                                    MaxLines="5" />

                        <FlexLayout
                                    Direction="Row"
                                    Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Start">

                            <Border
                                        BackgroundColor="#101F38"
                                        Stroke="{StaticResource AthenaBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,6"
                                        Margin="0,0,8,0">

                                <HorizontalStackLayout
                                            Spacing="6">

                                    <Label
                                                Text="&lt;/&gt;"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource AthenaBlueLight}"
                                                VerticalOptions="Center" />

                                    <Label
                                                x:Name="txtTituloCategoria"
                                                Text="Sem categoria"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                CharacterSpacing="0.4"
                                                TextColor="{StaticResource AthenaBlueLight}"
                                                VerticalOptions="Center" />

                                </HorizontalStackLayout>

                            </Border>

                            <HorizontalStackLayout
                                        Spacing="6"
                                        Padding="4,6">

                                <BoxView
                                            WidthRequest="7"
                                            HeightRequest="7"
                                            CornerRadius="4"
                                            Color="{StaticResource AthenaBlue}"
                                            VerticalOptions="Center" />

                                <Label
                                            Text="{Binding prioridadeMeta, TargetNullValue=Sem prioridade, FallbackValue=Sem prioridade}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource AthenaBlueLight}"
                                            VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </FlexLayout>

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <Border
                        BackgroundColor="#0D1726"
                        Stroke="#1B2A40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">

                <VerticalStackLayout
                            Spacing="14">

                    <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">

                        <HorizontalStackLayout
                                    Grid.Column="0"
                                    Spacing="9">

                            <Border
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        BackgroundColor="#101F38"
                                        Stroke="{StaticResource AthenaBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8">

                                <Label
                                            Text="↗"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource AthenaBlueLight}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                            </Border>

                            <Label
                                        Text="PROGRESSO DA META"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CharacterSpacing="0.8"
                                        TextColor="{StaticResource AthenaTextSecondary}"
                                        VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <Label
                                    Grid.Column="1"
                                    Text="{Binding Progresso, StringFormat='{0:P0}'}"
                                    FontSize="32"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AthenaBlueLight}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">

                            <Label.Triggers>

                                <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding status}"
                                            Value="Concluida">

                                    <Setter
                                                Property="TextColor"
                                                Value="{StaticResource AthenaSuccess}" />

                                </DataTrigger>

                                <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding status}"
                                            Value="Concluído">

                                    <Setter
                                                Property="TextColor"
                                                Value="{StaticResource AthenaSuccess}" />

                                </DataTrigger>

                            </Label.Triggers>

                        </Label>

                    </Grid>

                    <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">

                        <HorizontalStackLayout
                                    Grid.Column="0"
                                    Spacing="4"
                                    VerticalOptions="Center">

                            <Label
                                        Text="{Binding minutosEstudados, TargetNullValue=0}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource AthenaTextPrimary}" />

                            <Label
                                        Text=" / "
                                        FontSize="15"
                                        TextColor="{StaticResource AthenaTextSecondary}"
                                        VerticalOptions="End"
                                        Margin="0,0,0,2" />

                            <Label
                                        Text="{Binding metaMinutos, TargetNullValue=0}"
                                        FontSize="15"
                                        TextColor="{StaticResource AthenaTextSecondary}"
                                        VerticalOptions="End"
                                        Margin="0,0,0,2" />

                            <Label
                                        Text=" min"
                                        FontSize="15"
                                        TextColor="{StaticResource AthenaTextSecondary}"
                                        VerticalOptions="End"
                                        Margin="0,0,0,2" />

                        </HorizontalStackLayout>

                        <Label
                                    Grid.Column="1"
                                    Text="{Binding status}"
                                    FontSize="12"
                                    TextColor="{StaticResource AthenaTextSecondary}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center" />

                    </Grid>

                    <ProgressBar
                                Progress="{Binding Progresso}"
                                HeightRequest="7"
                                ProgressColor="{StaticResource AthenaBlue}"
                                BackgroundColor="#202E42"
                                HorizontalOptions="Fill">

                        <ProgressBar.Triggers>

                            <DataTrigger
                                        TargetType="ProgressBar"
                                        Binding="{Binding status}"
                                        Value="Concluida">

                                <Setter
                                            Property="ProgressColor"
                                            Value="{StaticResource AthenaSuccess}" />

                            </DataTrigger>

                            <DataTrigger
                                        TargetType="ProgressBar"
                                        Binding="{Binding status}"
                                        Value="Concluído">

                                <Setter
                                            Property="ProgressColor"
                                            Value="{StaticResource AthenaSuccess}" />

                            </DataTrigger>

                        </ProgressBar.Triggers>

                    </ProgressBar>

                    <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">

                        <HorizontalStackLayout
                                    Grid.Column="0"
                                    Spacing="6">

                            <BoxView
                                        WidthRequest="7"
                                        HeightRequest="7"
                                        CornerRadius="4"
                                        Color="{StaticResource AthenaSuccess}"
                                        VerticalOptions="Center" />

                            <Label
                                        Text="Ritmo de foco ativo • Ciclo em andamento"
                                        FontSize="10"
                                        TextColor="{StaticResource AthenaTextSecondary}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        VerticalOptions="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <Border
                        x:Name="UltimaSessaoCard"
                        IsVisible="False"
                        BackgroundColor="#0D1726"
                        Stroke="#1B2A40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">

                <VerticalStackLayout
                            Spacing="12">

                    <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">

                        <HorizontalStackLayout
                                    Grid.Column="0"
                                    Spacing="8">

                            <Border
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        BackgroundColor="#101F38"
                                        Stroke="{StaticResource AthenaBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        VerticalOptions="Center">

                                <Label
                                            Text="◷"
                                            FontSize="18"
                                            TextColor="{StaticResource AthenaBlueLight}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                            </Border>

                            <Label
                                        Text="ÚLTIMA SESSÃO"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CharacterSpacing="0.8"
                                        TextColor="{StaticResource AthenaGold}"
                                        VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <Border
                                    Grid.Column="1"
                                    BackgroundColor="#18382B"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,5"
                                    VerticalOptions="Center">

                            <HorizontalStackLayout
                                        Spacing="5">

                                <BoxView
                                            WidthRequest="6"
                                            HeightRequest="6"
                                            CornerRadius="3"
                                            Color="{StaticResource AthenaSuccess}"
                                            VerticalOptions="Center" />

                                <Label
                                            Text="Sessão concluída"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            CharacterSpacing="0.3"
                                            TextColor="{StaticResource AthenaSuccess}"
                                            VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </Border>

                    </Grid>

                    <VerticalStackLayout
                                Spacing="3">

                        <Label
                                    x:Name="UltimaSessaoTituloTXT"
                                    Text=""
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AthenaTextPrimary}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />

                        <Label
                                    x:Name="UltimaSessaoDataTXT"
                                    Text=""
                                    FontSize="12"
                                    TextColor="{StaticResource AthenaTextMuted}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                    </VerticalStackLayout>

                    <Border
                                BackgroundColor="#080B10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">

                        <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="10">

                            <Border
                                        Grid.Column="0"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="#101F38"
                                        Stroke="{StaticResource AthenaBlue}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 17"
                                        VerticalOptions="Center">

                                <Label
                                            Text="◷"
                                            FontSize="18"
                                            TextColor="{StaticResource AthenaBlueLight}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1"
                                        VerticalOptions="Center">

                                <Label
                                            Text="TEMPO ESTUDADO"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            CharacterSpacing="0.6"
                                            TextColor="{StaticResource AthenaTextMuted}" />

                                <Label
                                            x:Name="UltimaSessaoTempoTXT"
                                            Text=""
                                            FontSize="20"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource AthenaBlueLight}" />

                            </VerticalStackLayout>

                            <Label
                                        Grid.Column="2"
                                        Text="Última sessão"
                                        FontSize="10"
                                        TextColor="{StaticResource AthenaTextMuted}"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center" />

                        </Grid>

                    </Border>

                    <Border
                                BackgroundColor="#101A2B"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="11">

                        <VerticalStackLayout
                                    Spacing="5">

                            <HorizontalStackLayout
                                        Spacing="6">

                                <Label
                                            Text="✎"
                                            FontSize="15"
                                            TextColor="{StaticResource AthenaGold}"
                                            VerticalOptions="Center" />

                                <Label
                                            Text="ANOTAÇÃO DA SESSÃO"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            CharacterSpacing="0.6"
                                            TextColor="{StaticResource AthenaGold}"
                                            VerticalOptions="Center" />

                            </HorizontalStackLayout>

                            <Label
                                        x:Name="UltimaSessaoDescricaoTXT"
                                        Text=""
                                        FontSize="13"
                                        FontAttributes="Italic"
                                        TextColor="{StaticResource AthenaTextSecondary}"
                                        LineHeight="1.2"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="4" />

                        </VerticalStackLayout>

                    </Border>

                    <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">

                        <HorizontalStackLayout
                                    Grid.Column="0"
                                    Spacing="6"
                                    VerticalOptions="Center">

                            <Label
                                        Text="ⓘ"
                                        FontSize="14"
                                        TextColor="{StaticResource AthenaTextMuted}"
                                        VerticalOptions="Center" />

                            <Label
                                        Text="Suas anotações ajudam você a lembrar onde parou."
                                        FontSize="10"
                                        TextColor="{StaticResource AthenaTextSecondary}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <Label
                                    Grid.Column="1"
                                    Text="Histórico ›"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AthenaBlueLight}"
                                    VerticalOptions="Center" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <Border
                        x:Name="EstadoSemUltimaSessao"
                        BackgroundColor="#0D1726"
                        Stroke="#1B2A40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        IsVisible="False">

                <VerticalStackLayout
                            Spacing="8">

                    <HorizontalStackLayout
                                Spacing="8">

                        <Border
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    BackgroundColor="#101F38"
                                    Stroke="{StaticResource AthenaBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    VerticalOptions="Center">

                            <Label
                                        Text="◷"
                                        FontSize="18"
                                        TextColor="{StaticResource AthenaTextMuted}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                        </Border>

                        <Label
                                    Text="ÚLTIMA SESSÃO"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CharacterSpacing="0.8"
                                    TextColor="{StaticResource AthenaTextMuted}"
                                    VerticalOptions="Center" />

                    </HorizontalStackLayout>

                    <Label
                                Text="Nenhuma sessão registrada nesta meta"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AthenaTextPrimary}"
                                Margin="0,4,0,0" />

                    <Label
                                Text="Suas anotações aparecerão aqui para ajudar você a continuar seus estudos."
                                FontSize="13"
                                TextColor="{StaticResource AthenaTextSecondary}"
                                LineBreakMode="WordWrap"
                                MaxLines="3" />

                </VerticalStackLayout>

            </Border>

            <Border
                        BackgroundColor="#0D1726"
                        Stroke="#1B2A40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="1">

                <Grid
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="*,*"
                            RowSpacing="1"
                            ColumnSpacing="1"
                            BackgroundColor="#263650">

                    <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="#0D1726"
                                StrokeThickness="0"
                                Padding="14">

                        <VerticalStackLayout
                                    Spacing="8">

                            <Label
                                        Text="PRIORIDADE"
                                        FontSize="10"
                                        CharacterSpacing="0.6"
                                        TextColor="{StaticResource AthenaTextSecondary}" />

                            <HorizontalStackLayout
                                        Spacing="8">

                                <BoxView
                                            WidthRequest="8"
                                            HeightRequest="8"
                                            CornerRadius="4"
                                            Color="{StaticResource AthenaBlue}"
                                            VerticalOptions="Center" />

                                <Label
                                            Text="{Binding prioridadeMeta, TargetNullValue=Sem prioridade, FallbackValue=Sem prioridade}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource AthenaTextPrimary}" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                BackgroundColor="#0D1726"
                                StrokeThickness="0"
                                Padding="14">

                        <VerticalStackLayout
                                    Spacing="8">

                            <Label
                                        Text="STATUS"
                                        FontSize="10"
                                        CharacterSpacing="0.6"
                                        TextColor="{StaticResource AthenaTextSecondary}" />

                            <HorizontalStackLayout
                                        Spacing="8">

                                <BoxView
                                            WidthRequest="8"
                                            HeightRequest="8"
                                            CornerRadius="4"
                                            Color="{StaticResource AthenaSuccess}"
                                            VerticalOptions="Center" />

                                <Label
                                            Text="{Binding status}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource AthenaBlueLight}" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                BackgroundColor="#0D1726"
                                StrokeThickness="0"
                                Padding="14">

                        <VerticalStackLayout
                                    Spacing="8">

                            <Label
                                        Text="CRIADA EM"
                                        FontSize="10"
                                        CharacterSpacing="0.6"
                                        TextColor="{StaticResource AthenaTextSecondary}" />

                            <HorizontalStackLayout
                                        Spacing="7">

                                <Label
                                            Text="▧"
                                            FontSize="15"
                                            TextColor="{StaticResource AthenaTextSecondary}"
                                            VerticalOptions="Center" />

                                <Label
                                            Text="{Binding dataCriacao, StringFormat='{0:dd MMM yyyy}'}"
                                            FontSize="13"
                                            TextColor="{StaticResource AthenaTextPrimary}"
                                            VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="#0D1726"
                                StrokeThickness="0"
                                Padding="14">

                        <VerticalStackLayout
                                    Spacing="8">

                            <Label
                                        Text="DATA LIMITE"
                                        FontSize="10"
                                        CharacterSpacing="0.6"
                                        TextColor="{StaticResource AthenaTextSecondary}" />

                            <HorizontalStackLayout
                                        Spacing="7">

                                <Label
                                            Text="□"
                                            FontSize="15"
                                            TextColor="{StaticResource AthenaGold}"
                                            VerticalOptions="Center" />

                                <Label
                                            Text="{Binding TextoDataLimite, TargetNullValue=Sem data limite, FallbackValue=Sem data limite}"
                                            FontSize="13"
                                            TextColor="{StaticResource AthenaTextPrimary}"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </Grid>

            </Border>

            <VerticalStackLayout
                        Spacing="10"
                        Padding="2,10,2,0">

                <Label
                            Text="O que deseja fazer agora?"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AthenaTextPrimary}" />

                <Label
                            Text="Ações disponíveis para impulsionar esta meta."
                            FontSize="13"
                            TextColor="{StaticResource AthenaTextSecondary}" />

                <VerticalStackLayout
                            Spacing="6"
                            Padding="0,4,0,0">

                    <Button
                                Text="⊕  CRIAR SESSÃO DE ESTUDO"
                                Clicked="Button_Clicked"
                                HeightRequest="52"
                                CornerRadius="12"
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="{StaticResource AthenaGoldButton}"
                                TextColor="{StaticResource Black}"
                                BorderWidth="0"
                                HorizontalOptions="Fill" />

                    <Label
                                Text="Defina uma sessão vinculada a esta meta."
                                FontSize="11"
                                TextColor="{StaticResource AthenaTextSecondary}"
                                HorizontalTextAlignment="Center"
                                HorizontalOptions="Center" />

                </VerticalStackLayout>

                <VerticalStackLayout
                            Spacing="6"
                            Padding="0,4,0,0">

                    <Button
                                Text="▷  COMEÇAR A ESTUDAR"
                                Clicked="Button_Clicked_1"
                                HeightRequest="50"
                                CornerRadius="12"
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="#101F38"
                                TextColor="{StaticResource AthenaBlueLight}"
                                BorderColor="{StaticResource AthenaBlue}"
                                BorderWidth="1"
                                HorizontalOptions="Fill" />

                    <Label
                                Text="Inicie o cronômetro para esta meta."
                                FontSize="11"
                                TextColor="{StaticResource AthenaTextSecondary}"
                                HorizontalTextAlignment="Center"
                                HorizontalOptions="Center" />

                </VerticalStackLayout>

                <Border
                            BackgroundColor="#0D1726"
                            Stroke="#1B2A40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="13"
                            Margin="0,4,0,0">

                    <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12">

                        <Border
                                    Grid.Column="0"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="#101F38"
                                    Stroke="{StaticResource AthenaBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">

                            <Label
                                        Text="◷"
                                        FontSize="21"
                                        TextColor="{StaticResource AthenaBlueLight}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">

                            <Label
                                        Text="Ver histórico de sessões"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource AthenaTextPrimary}" />

                            <Label
                                        Text="Consulte seus estudos anteriores nesta meta."
                                        FontSize="11"
                                        TextColor="{StaticResource AthenaTextSecondary}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />

                        </VerticalStackLayout>

                        <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="27"
                                    TextColor="{StaticResource AthenaTextSecondary}"
                                    VerticalOptions="Center" />

                        <Button
