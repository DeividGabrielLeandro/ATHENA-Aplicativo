<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ATHENA.Metas.xaml.EditarMeta"
    BackgroundColor="{StaticResource AthenaBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="True">

    <ScrollView>

        <VerticalStackLayout
            Padding="16,16,16,32"
            Spacing="16">

            <Grid
    ColumnDefinitions="Auto,*,Auto"
    RowDefinitions="Auto,Auto"
    ColumnSpacing="10"
    RowSpacing="8">

                <Button
        Grid.Column="0"
        Grid.Row="0"
        Text="‹"
        Clicked="Voltar_Clicked"
        WidthRequest="40"
        HeightRequest="40"
        Padding="0"
        CornerRadius="10"
        FontSize="32"
        TextColor="{StaticResource AthenaBlueLight}"
        BackgroundColor="{StaticResource AthenaSurface}"
        BorderColor="{StaticResource AthenaBorder}"
        BorderWidth="1"
        HorizontalOptions="Start"
        VerticalOptions="Start" />

                <VerticalStackLayout
        Grid.Column="1"
        Grid.Row="0"
        Spacing="3">

                    <Image
            Source="athena_wordmark_header_styled.png"
            WidthRequest="112"
            HeightRequest="28"
            Aspect="AspectFit"
            HorizontalOptions="Start" />

                    <Label
            Text="EDITAR META"
            FontSize="9"
            CharacterSpacing="1"
            TextColor="{StaticResource AthenaTextSecondary}"
            HorizontalOptions="Start" />

                </VerticalStackLayout>

                <Border
        Grid.Column="2"
        Grid.Row="0"
        BackgroundColor="#49391F"
        Stroke="{StaticResource AthenaGold}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 12"
        Padding="9,6"
        VerticalOptions="Center">

                    <HorizontalStackLayout
            Spacing="6">

                        <BoxView
                WidthRequest="6"
                HeightRequest="6"
                CornerRadius="3"
                Color="{StaticResource AthenaGold}"
                VerticalOptions="Center" />

                        <Label
                Text="Editando"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource AthenaGoldLight}"
                VerticalOptions="Center" />

                    </HorizontalStackLayout>

                </Border>

                <BoxView
        Grid.Row="1"
        Grid.ColumnSpan="3"
        HeightRequest="1"
        Margin="0,14,0,0"
        Color="#24344B"
        HorizontalOptions="Fill" />

            </Grid>


            <HorizontalStackLayout
                Spacing="7"
                Padding="2,0">

                <BoxView
                    WidthRequest="7"
                    HeightRequest="7"
                    CornerRadius="4"
                    Color="{StaticResource AthenaGold}"
                    VerticalOptions="Center" />

                <Label
                    Text="MODO DE EDIÇÃO ATIVO"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    TextColor="{StaticResource AthenaGoldLight}"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <CollectionView
                x:Name="listaMetas"
                HeightRequest="166"
                SelectionMode="None"
                ItemsLayout="VerticalList"
                VerticalScrollBarVisibility="Never"
                HorizontalOptions="Fill">

                <CollectionView.EmptyView>

                    <Border
                        BackgroundColor="#0D1726"
                        Stroke="#1B2A40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">

                        <Label
                            Text="Nenhuma meta carregada."
                            FontSize="13"
                            TextColor="{StaticResource AthenaTextSecondary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BackgroundColor="#0D1726"
                            Stroke="#1B2A40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="0"
                            HorizontalOptions="Fill">

                            <Grid
                                ColumnDefinitions="4,*"
                                ColumnSpacing="0">

                                <BoxView
                                    Grid.Column="0"
                                    Color="{StaticResource AthenaGold}"
                                    CornerRadius="2"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Padding="16"
                                    Spacing="10">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8">

                                        <HorizontalStackLayout
                                            Grid.Column="0"
                                            Spacing="7">

                                            <Label
                                                Text="◎"
                                                FontSize="18"
                                                TextColor="{StaticResource AthenaGold}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Text="META SELECIONADA"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                CharacterSpacing="0.8"
                                                TextColor="{StaticResource AthenaGoldLight}"
                                                VerticalOptions="Center" />

                                        </HorizontalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="#101F38"
                                            Stroke="{StaticResource AthenaBlue}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="8,4">

                                            <HorizontalStackLayout
                                                Spacing="5">

                                                <BoxView
                                                    WidthRequest="6"
                                                    HeightRequest="6"
                                                    CornerRadius="3"
                                                    Color="{StaticResource AthenaBlue}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Text="{Binding status}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource AthenaBlueLight}"
                                                    VerticalOptions="Center" />

                                            </HorizontalStackLayout>

                                        </Border>

                                    </Grid>

                                    <Label
                                        x:Name="TituloPrincipalTXT"
                                        Text="{Binding tituloMeta}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource AthenaTextPrimary}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2" />

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8">

                                        <Label
                                            Grid.Column="0"
                                            Text="Progresso da meta"
                                            FontSize="12"
                                            TextColor="{StaticResource AthenaTextSecondary}" />

                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            Spacing="3">

                                            <Label
                                                Text="{Binding minutosEstudados, StringFormat='{0:F0}', TargetNullValue=0}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource AthenaTextPrimary}" />

                                            <Label
                                                Text=" / "
                                                FontSize="12"
                                                TextColor="{StaticResource AthenaTextSecondary}" />

                                            <Label
                                                Text="{Binding metaMinutos, TargetNullValue=0}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource AthenaTextPrimary}" />

                                            <Label
                                                Text=" min estudados"
                                                FontSize="12"
                                                TextColor="{StaticResource AthenaTextSecondary}" />

                                        </HorizontalStackLayout>

                                    </Grid>

                                    <ProgressBar
                                        Progress="{Binding Progresso}"
                                        HeightRequest="6"
                                        ProgressColor="{StaticResource AthenaBlue}"
                                        BackgroundColor="#202E42"
                                        HorizontalOptions="Fill" />

                                    <Label
                                        Text="Os dados abaixo refletem as configurações salvas desta meta."
                                        FontSize="10"
                                        TextColor="{StaticResource AthenaTextMuted}"
                                        LineBreakMode="WordWrap"
                                        MaxLines="2" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="INFORMAÇÕES DA META"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    TextColor="{StaticResource AthenaTextSecondary}" />

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="TÍTULO DA META *"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource AthenaTextPrimary}" />

                    <Border
                        BackgroundColor="#080B10"
                        Stroke="#1B2A40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0"
                        HeightRequest="48">

                        <Entry
                            x:Name="TituloTXT"
                            Placeholder="Título atual da meta"
                            PlaceholderColor="{StaticResource AthenaTextMuted}"
                            TextColor="{StaticResource AthenaTextPrimary}"
                            FontSize="14"
                            ClearButtonVisibility="WhileEditing"
                            VerticalOptions="Center" />

                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Spacing="6"
                    Margin="0,4,0,0">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <Label
                            Grid.Column="0"
                            Text="DESCRIÇÃO"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AthenaTextPrimary}" />

                        <Label
                            Grid.Column="1"
                            Text="Opcional"
                            FontSize="10"
                            TextColor="{StaticResource AthenaTextMuted}" />

                    </Grid>

                    <Border
                        BackgroundColor="#080B10"
                        Stroke="#1B2A40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,8"
                        MinimumHeightRequest="92">

                        <Editor
                            x:Name="DescricaoTXT"
                            Placeholder="Descreva o propósito ou os tópicos centrais..."
                            PlaceholderColor="{StaticResource AthenaTextMuted}"
                            TextColor="{StaticResource AthenaTextPrimary}"
                            FontSize="13"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="76"
                            VerticalOptions="Fill" />

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="OBJETIVO DE TEMPO"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    TextColor="{StaticResource AthenaTextSecondary}" />

                <Border
                    BackgroundColor="#0D1726"
                    Stroke="#1B2A40"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="14">

                    <VerticalStackLayout
                        Spacing="8">

                        <Label
                            Text="MINUTOS DESEJADOS"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AthenaTextPrimary}" />

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="◷"
                                FontSize="21"
                                TextColor="{StaticResource AthenaTextSecondary}"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#080B10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,0"
                                HeightRequest="48">

                                <Entry
                                    x:Name="MinutosTXT"
                                    Placeholder="60"
                                    PlaceholderColor="{StaticResource AthenaTextMuted}"
                                    TextColor="{StaticResource AthenaTextPrimary}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    Keyboard="Numeric"
                                    VerticalOptions="Center" />

                            </Border>

                            <Border
                                Grid.Column="2"
                                BackgroundColor="#272A30"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 9"
                                Padding="12,0"
                                HeightRequest="48">

                                <Label
                                    Text="min"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AthenaBlueLight}"
                                    VerticalOptions="Center" />

                            </Border>

                        </Grid>

                        <Label
                            Text="Meta estimada para contagem regressiva e sessões no cronômetro."
                            FontSize="10"
                            TextColor="{StaticResource AthenaTextMuted}"
                            LineBreakMode="WordWrap"
                            MaxLines="2" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="PRIORIDADE"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    TextColor="{StaticResource AthenaTextSecondary}" />

                <Border
                    BackgroundColor="#0D1726"
                    Stroke="#1B2A40"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="8">

                    <VerticalStackLayout
                        Spacing="1">

                        <RadioButton
                            x:Name="RadioSemPrioridade"
                            Content="Sem prioridade"
                            GroupName="PrioridadeMeta"
                            IsChecked="True"
                            TextColor="{StaticResource AthenaTextPrimary}"
                            FontSize="14"
                            Padding="8,6" />

                        <RadioButton
                            x:Name="RadioBaixa"
                            Content="Baixa prioridade"
                            GroupName="PrioridadeMeta"
                            TextColor="{StaticResource AthenaTextPrimary}"
                            FontSize="14"
                            Padding="8,6" />

                        <RadioButton
                            x:Name="RadioMedia"
                            Content="Média prioridade"
                            GroupName="PrioridadeMeta"
                            TextColor="{StaticResource AthenaTextPrimary}"
                            FontSize="14"
                            Padding="8,6" />

                        <RadioButton
                            x:Name="RadioAlta"
                            Content="Alta prioridade"
                            GroupName="PrioridadeMeta"
                            TextColor="{StaticResource AthenaGoldLight}"
                            FontSize="14"
                            Padding="8,6" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <VerticalStackLayout
    Spacing="8">

                <Grid
        ColumnDefinitions="*,Auto"
        ColumnSpacing="8">

                    <Label
            Grid.Column="0"
            Text="DATA LIMITE"
            FontSize="11"
            FontAttributes="Bold"
            CharacterSpacing="0.5"
            TextColor="{StaticResource AthenaTextPrimary}" />


                </Grid>

                <Border
        x:Name="DataLimitePicker"
        BackgroundColor="{StaticResource AthenaSurface}"
        Stroke="{StaticResource AthenaBorder}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 11"
        Padding="10,0"
        HeightRequest="52">

                    <Grid
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="9">

                        <Border
                Grid.Column="0"
                WidthRequest="30"
                HeightRequest="30"
                BackgroundColor="{StaticResource AthenaBlueBackground}"
                Stroke="{StaticResource AthenaBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                VerticalOptions="Center">

                            <Label
                    Text="□"
                    FontSize="17"
                    TextColor="{StaticResource AthenaGoldLight}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                        </Border>

                        <Label
                x:Name="DataLimiteTXT"
                Grid.Column="1"
                Text="Sem data limite"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="{StaticResource AthenaTextSecondary}"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                VerticalOptions="Center" />

                        <Button
                x:Name="BtnRemoverData"
                Grid.Column="2"
                Text="Remover"
                Clicked="Button_Clicked_1"
                IsVisible="True"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{StaticResource AthenaTextMuted}"
                BackgroundColor="{StaticResource AthenaCard}"
                BorderColor="{StaticResource AthenaBorderSoft}"
                BorderWidth="1"
                CornerRadius="7"
                Padding="7,0"
                HeightRequest="30"
                VerticalOptions="Center" />

                        <Button
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text=""
                Clicked="Button_Clicked"
                BackgroundColor="Transparent"
                BorderWidth="0"
                Padding="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

                    </Grid>

                </Border>

                <DatePicker
        x:Name="PrazoDate"
        IsVisible="False"
        Format="dd/MM/yyyy"
        DateSelected="PrazoDate_DateSelected"
        BackgroundColor="{StaticResource AthenaSurface}"
        TextColor="{StaticResource AthenaTextPrimary}" />

            </VerticalStackLayout>


            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="STATUS DA META"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    TextColor="{StaticResource AthenaTextSecondary}" />

                <Border
                    BackgroundColor="#0D1726"
                    Stroke="#1B2A40"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="14">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label
                                Text="Marcar como concluída"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AthenaTextPrimary}" />

                            <Label
                                Text="Alterna entre Em andamento e Concluída"
                                FontSize="11"
                                TextColor="{StaticResource AthenaTextSecondary}" />

                        </VerticalStackLayout>

                        <Switch
                            x:Name="SwitchConcluida"
                            Grid.Column="1"
                            IsToggled="False"
                            OnColor="{StaticResource AthenaSuccess}"
                            ThumbColor="{StaticResource AthenaTextPrimary}"
                            HorizontalOptions="End"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10"
                Padding="0,8,0,0">

                <Button
                    Text="▣  SALVAR ALTERAÇÕES"
                    Clicked="Button_Clicked_2"
                    HeightRequest="52"
                    CornerRadius="11"
                    FontSize="14"
                    FontAttributes="Bold"
                    CharacterSpacing="0.4"
                    BackgroundColor="{StaticResource AthenaGoldButton}"
                    TextColor="{StaticResource Black}"
                    BorderWidth="0"
                    HorizontalOptions="Fill" />

                <Button
                    Text="▥  EXCLUIR META"
                    Clicked="Button_Clicked_3"
                    HeightRequest="46"
                    CornerRadius="10"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="0.4"
                    BackgroundColor="#3A2022"
                    TextColor="{StaticResource AthenaError}"
                    BorderColor="{StaticResource AthenaError}"
                    BorderWidth="1"
                    HorizontalOptions="Fill" />

                <Label
                    Text="⚠ Essa ação não pode ser desfeita. Todos os registros vinculados serão removidos."
                    FontSize="10"
                    TextColor="{StaticResource AthenaError}"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center"
                    LineBreakMode="WordWrap"
                    MaxLines="3" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
