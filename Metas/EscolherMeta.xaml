<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ATHENA.Metas.xaml.EscolherMeta"
    BackgroundColor="{StaticResource AthenaBackground}"
    Shell.NavBarIsVisible="False">

    <Grid
        RowDefinitions="Auto,Auto,Auto,Auto,*">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            Padding="16,16,16,0"
            Margin="0,0,0,14">

            <VerticalStackLayout
                Grid.Column="0"
                Grid.Row="0"
                Spacing="3"
                VerticalOptions="Start">

                <Image
                    Source="athena_wordmark_header_styled.png"
                    WidthRequest="112"
                    HeightRequest="28"
                    Aspect="AspectFit"
                    HorizontalOptions="Start" />

                <Label
                    Text="METAS DE ESTUDO"
                    FontSize="9"
                    CharacterSpacing="1"
                    TextColor="{StaticResource AthenaTextSecondary}"
                    HorizontalOptions="Start" />

            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                Grid.Row="0"
                WidthRequest="38"
                HeightRequest="38"
                Padding="1"
                BackgroundColor="{StaticResource AthenaIconBackground}"
                Stroke="{StaticResource AthenaGold}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 19"
                HorizontalOptions="End"
                VerticalOptions="Start">

                <Image
                    x:Name="ImagemPerfil"
                    Aspect="AspectFill"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

            </Border>

            <BoxView
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HeightRequest="1"
                Margin="0,14,0,0"
                Color="{StaticResource AthenaDivider}"
                HorizontalOptions="Fill" />

        </Grid>

        <VerticalStackLayout
            Grid.Row="1"
            Padding="16,4,16,0"
            Spacing="0">

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10"
                Margin="0,0,0,14">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="3"
                    VerticalOptions="Center">

                    <Label
                        Text="Suas metas"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="{StaticResource AthenaTextHeading}" />

                    <Label
                        Text="Organize seu progresso e continue avançando."
                        FontSize="12"
                        TextColor="{StaticResource AthenaTextSecondary}" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    Stroke="{StaticResource AthenaGold}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    VerticalOptions="Center">

                    <Label
                        Text="✥"
                        FontSize="22"
                        TextColor="{StaticResource AthenaGoldLight}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

            </Grid>

            <Button
                Text="+    CRIAR NOVA META"
                Clicked="Button_Clicked"
                HeightRequest="48"
                CornerRadius="11"
                FontSize="14"
                FontAttributes="Bold"
                CharacterSpacing="0.7"
                BackgroundColor="{StaticResource AthenaGoldButton}"
                TextColor="{StaticResource Black}"
                BorderWidth="0"
                HorizontalOptions="Fill"
                Margin="0,0,0,16" />

        </VerticalStackLayout>

        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource AthenaCard}"
            Stroke="{StaticResource AthenaBorderSoft}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14"
            Padding="8"
            Margin="16,0,16,16">

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="5">

                <Border
                    Grid.Column="0"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 9"
                    Padding="6,8">

                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center">

                        <Label
                            Text="TOTAL"
                            FontSize="9"
                            CharacterSpacing="0.8"
                            TextColor="{StaticResource AthenaTextSecondary}"
                            HorizontalOptions="Center" />

                        <HorizontalStackLayout
                            Spacing="4"
                            HorizontalOptions="Center">

                            <Label
                                x:Name="lblTotalMetas"
                                Text="0"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AthenaTextPrimary}" />

                            <Label
                                Text="metas"
                                FontSize="10"
                                TextColor="{StaticResource AthenaTextSecondary}"
                                VerticalOptions="End"
                                Margin="0,0,0,2" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 9"
                    Padding="6,8">

                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center">

                        <HorizontalStackLayout
                            Spacing="5"
                            HorizontalOptions="Center">

                            <BoxView
                                WidthRequest="6"
                                HeightRequest="6"
                                CornerRadius="3"
                                Color="{StaticResource AthenaBlue}"
                                VerticalOptions="Center" />

                            <Label
                                Text="EM ANDAMENTO"
                                FontSize="8"
                                CharacterSpacing="0.4"
                                TextColor="{StaticResource AthenaBlueLight}"
                                HorizontalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Spacing="4"
                            HorizontalOptions="Center">

                            <Label
                                x:Name="lblMetasPendentes"
                                Text="0"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AthenaBlueLight}" />

                            <Label
                                Text="metas"
                                FontSize="10"
                                TextColor="{StaticResource AthenaTextSecondary}"
                                VerticalOptions="End"
                                Margin="0,0,0,2" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="2"
                    BackgroundColor="{StaticResource AthenaSurface}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 9"
                    Padding="6,8">

                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center">

                        <HorizontalStackLayout
                            Spacing="5"
                            HorizontalOptions="Center">

                            <BoxView
                                WidthRequest="6"
                                HeightRequest="6"
                                CornerRadius="3"
                                Color="{StaticResource AthenaSuccess}"
                                VerticalOptions="Center" />

                            <Label
                                Text="CONCLUÍDAS"
                                FontSize="8"
                                CharacterSpacing="0.4"
                                TextColor="{StaticResource AthenaSuccess}"
                                HorizontalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Spacing="4"
                            HorizontalOptions="Center">

                            <Label
                                x:Name="lblMetasConcluidas"
                                Text="0"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AthenaSuccess}" />

                            <Label
                                Text="metas"
                                FontSize="10"
                                TextColor="{StaticResource AthenaTextSecondary}"
                                VerticalOptions="End"
                                Margin="0,0,0,2" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </Border>

        <VerticalStackLayout
            Grid.Row="3"
            Padding="16,0,16,0"
            Spacing="0">

            <Border
                BackgroundColor="{StaticResource AthenaSurface}"
                Stroke="{StaticResource AthenaBorderSoft}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 11"
                Padding="10,0"
                HeightRequest="46">

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="8">

                    <Label
                        Grid.Column="0"
                        Text="⌕"
                        FontSize="23"
                        TextColor="{StaticResource AthenaTextSecondary}"
                        VerticalOptions="Center" />

                    <Entry
                        Grid.Column="1"
                        x:Name="BuscaMetaTXT"
                        Placeholder="Buscar meta por nome..."
                        PlaceholderColor="{StaticResource AthenaTextMuted}"
                        TextColor="{StaticResource AthenaTextPrimary}"
                        FontSize="13"
                        ClearButtonVisibility="WhileEditing"
                        ReturnType="Search"
                        Completed="BuscaMetaTXT_Completed"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="2"
                        Text="☷"
                        FontSize="20"
                        TextColor="{StaticResource AthenaTextSecondary}"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <ScrollView
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                Margin="0,10,0,10">

                <HorizontalStackLayout
                    Spacing="7">

                    <Button
                        x:Name="BtnFiltroTodas"
                        Text="▣  Todas"
                        Clicked="BtnFiltroTodas_Clicked"
                        HeightRequest="34"
                        Padding="12,0"
                        CornerRadius="8"
                        FontSize="12"
                        BackgroundColor="{StaticResource AthenaBlueBackground}"
                        BorderColor="{StaticResource AthenaBlue}"
                        BorderWidth="1"
                        TextColor="{StaticResource AthenaTextPrimary}" />

                    <Button
                        x:Name="BtnFiltroPendentes"
                        Text="●  Em andamento"
                        Clicked="BtnFiltroPendentes_Clicked"
                        HeightRequest="34"
                        Padding="12,0"
                        CornerRadius="8"
                        FontSize="12"
                        BackgroundColor="{StaticResource AthenaCard}"
                        BorderColor="{StaticResource AthenaBorderSoft}"
                        BorderWidth="1"
                        TextColor="{StaticResource AthenaTextSecondary}" />

                    <Button
                        x:Name="BtnFiltroConcluidas"
                        Text="●  Concluídas"
                        Clicked="BtnFiltroConcluidas_Clicked"
                        HeightRequest="34"
                        Padding="12,0"
                        CornerRadius="8"
                        FontSize="12"
                        BackgroundColor="{StaticResource AthenaCard}"
                        BorderColor="{StaticResource AthenaBorderSoft}"
                        BorderWidth="1"
                        TextColor="{StaticResource AthenaTextSecondary}" />

                </HorizontalStackLayout>

            </ScrollView>

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="4"
            x:Name="lista"
            SelectionMode="None"
            ItemsLayout="VerticalList"
            VerticalScrollBarVisibility="Never"
            ItemsUpdatingScrollMode="KeepItemsInView"
            Margin="16,0,16,0">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20,60,20,24"
                    Spacing="12"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="◎"
                        FontSize="44"
                        TextColor="{StaticResource AthenaGold}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Nenhuma meta encontrada"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource AthenaTextPrimary}"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Crie uma meta para começar a acompanhar seu progresso."
                        FontSize="13"
                        TextColor="{StaticResource AthenaTextSecondary}"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center"
                        LineBreakMode="WordWrap"
                        MaxLines="2" />

                    <Button
                        Text="+  CRIAR NOVA META"
                        Clicked="Button_Clicked"
                        HeightRequest="46"
                        CornerRadius="9"
                        BackgroundColor="{StaticResource AthenaGoldButton}"
                        TextColor="{StaticResource Black}"
                        FontAttributes="Bold"
                        FontSize="12"
                        Padding="18,0"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="{StaticResource AthenaCard}"
                        Stroke="{StaticResource AthenaBorderSoft}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14"
                        Margin="0,0,0,10">

                        <Grid
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            ColumnDefinitions="*"
                            RowSpacing="8">

                            <Grid
                                Grid.Row="0"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="6">

                                <HorizontalStackLayout
                                    Grid.Column="0"
                                    Spacing="6"
                                    VerticalOptions="Center">

                                    <Border
                                        BackgroundColor="{StaticResource AthenaSurface}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 7"
                                        Padding="8,4">

                                        <Label
                                            Text="{Binding CategoriaTexto, TargetNullValue=Sem categoria, FallbackValue=Sem categoria}"
                                            FontSize="9"
                                            CharacterSpacing="0.3"
                                            TextColor="{StaticResource AthenaTextSecondary}"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1" />

                                    </Border>

                                    <Border
                                        BackgroundColor="{StaticResource AthenaGoldSoft}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 7"
                                        Padding="8,4">

                                        <HorizontalStackLayout
                                            Spacing="4">

                                            <BoxView
                                                WidthRequest="6"
                                                HeightRequest="6"
                                                CornerRadius="3"
                                                Color="{StaticResource AthenaGold}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Text="{Binding prioridadeMeta}"
                                                FontSize="9"
                                                TextColor="{StaticResource AthenaGoldLight}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />

                                        </HorizontalStackLayout>

                                    </Border>

                                </HorizontalStackLayout>

                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <BoxView
                                        WidthRequest="6"
                                        HeightRequest="6"
                                        CornerRadius="3"
                                        Color="{StaticResource AthenaBlue}"
                                        VerticalOptions="Center">

                                        <BoxView.Triggers>

                                            <DataTrigger
                                                TargetType="BoxView"
                                                Binding="{Binding status}"
                                                Value="Concluida">

                                                <Setter
                                                    Property="Color"
                                                    Value="{StaticResource AthenaSuccess}" />

                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="BoxView"
                                                Binding="{Binding status}"
                                                Value="Concluído">

                                                <Setter
                                                    Property="Color"
                                                    Value="{StaticResource AthenaSuccess}" />

                                            </DataTrigger>

                                        </BoxView.Triggers>

                                    </BoxView>

                                    <Label
                                        Text="{Binding status}"
                                        FontSize="9"
                                        TextColor="{StaticResource AthenaBlueLight}"
                                        VerticalOptions="Center">

                                        <Label.Triggers>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding status}"
                                                Value="Concluida">

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource AthenaSuccess}" />

                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding status}"
                                                Value="Concluído">

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource AthenaSuccess}" />

                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>


                                </HorizontalStackLayout>

                            </Grid>

                            <Label
                                Grid.Row="1"
                                Text="{Binding tituloMeta}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AthenaTextPrimary}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1">

                                <Label.Triggers>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding status}"
                                        Value="Concluida">

                                        <Setter
                                            Property="TextDecorations"
                                            Value="Strikethrough" />

                                        <Setter
                                            Property="TextColor"
                                            Value="{StaticResource AthenaTextMuted}" />

                                    </DataTrigger>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding status}"
                                        Value="Concluído">

                                        <Setter
                                            Property="TextDecorations"
                                            Value="Strikethrough" />

                                        <Setter
                                            Property="TextColor"
                                            Value="{StaticResource AthenaTextMuted}" />

                                    </DataTrigger>

                                </Label.Triggers>

                            </Label>

                            <Label
                                Grid.Row="2"
                                Text="{Binding descricaoMeta, TargetNullValue=Sem descrição, FallbackValue=Sem descrição}"
                                FontSize="13"
                                TextColor="{StaticResource AthenaTextSecondary}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />

                            <Grid
                                Grid.Row="3"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="6">

                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">

                                    <HorizontalStackLayout
                                        Grid.Column="0"
                                        Spacing="2"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding minutosEstudados, TargetNullValue=0}"
                                            FontSize="12"
                                            TextColor="{StaticResource AthenaTextPrimary}" />

                                        <Label
                                            Text=" / "
                                            FontSize="12"
                                            TextColor="{StaticResource AthenaTextSecondary}" />

                                        <Label
                                            Text="{Binding metaMinutos}"
                                            FontSize="12"
                                            TextColor="{StaticResource AthenaTextPrimary}" />

                                        <Label
                                            Text=" min"
                                            FontSize="12"
                                            TextColor="{StaticResource AthenaTextSecondary}" />

                                    </HorizontalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Progresso, StringFormat='{0:P0}'}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource AthenaBlueLight}"
                                        HorizontalOptions="End">

                                        <Label.Triggers>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding status}"
                                                Value="Concluida">

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource AthenaSuccess}" />

                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding status}"
                                                Value="Concluído">

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource AthenaSuccess}" />

                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                </Grid>

                                <ProgressBar
                                    Grid.Row="1"
                                    Progress="{Binding Progresso}"
                                    HeightRequest="6"
                                    ProgressColor="{StaticResource AthenaBlueStrong}"
                                    BackgroundColor="{StaticResource AthenaProgressTrack}">

                                    <ProgressBar.Triggers>

                                        <DataTrigger
                                            TargetType="ProgressBar"
                                            Binding="{Binding status}"
                                            Value="Concluida">

                                            <Setter
                                                Property="ProgressColor"
                                                Value="{StaticResource AthenaSuccess}" />

                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="ProgressBar"
                                            Binding="{Binding status}"
                                            Value="Concluído">

                                            <Setter
                                                Property="ProgressColor"
                                                Value="{StaticResource AthenaSuccess}" />

                                        </DataTrigger>

                                    </ProgressBar.Triggers>

                                </ProgressBar>

                            </Grid>

                            <Grid
                                Grid.Row="4"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding dataLimite, StringFormat='Prazo: {0}', TargetNullValue=Sem prazo}"
                                    FontSize="11"
                                    TextColor="{StaticResource AthenaTextMuted}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding TextoSessaoMeta, TargetNullValue=''}"
                                    FontSize="11"
                                    TextColor="{StaticResource AthenaTextMuted}"
                                    HorizontalOptions="End"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                            </Grid>

                            <Button
                                Grid.Row="0"
                                Grid.RowSpan="5"
                                Grid.Column="0"
                                Text=""
                                Clicked="Button_Clicked_3"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Padding="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                ZIndex="10" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
