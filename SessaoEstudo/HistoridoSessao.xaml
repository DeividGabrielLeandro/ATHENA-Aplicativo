<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ATHENA.SessaoEstudo.HistoridoSessao"
             BackgroundColor="{StaticResource AthenaBackground}">

    <ScrollView>

        <VerticalStackLayout
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Spacing="20"
            Padding="10">

            <Image
            Source="logo_athena.png"
            WidthRequest="240"
            HeightRequest="36"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Aspect="AspectFit" />

            <CollectionView
                x:Name="HistoricoSessao">

                <CollectionView.ItemTemplate>

                    <DataTemplate>


                        <VerticalStackLayout
                            Spacing="8"
                            Padding="10">

                <Border
    BackgroundColor="Snow"
    Padding="10"
    Stroke="LightGray"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 14"
    HeightRequest="140">

                    <Grid ColumnDefinitions="2*, Auto, 3*, Auto, 2*" VerticalOptions="Center">

                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding tituloSessao}" FontAttributes="Bold" TextColor="Black" />
                                        <Label Text="{Binding DataCriacao}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>

                        <BoxView 
            Grid.Column="1" 
            WidthRequest="1" 
            Color="Black" 
            Opacity="0.2" 
            VerticalOptions="Fill" 
            Margin="5,0" />

                        <Label 
            Grid.Column="2" 
            Text="{Binding descricaoSessao}" 
            TextColor="Black" 
            VerticalOptions="Center" />

                        <BoxView 
            Grid.Column="3" 
            WidthRequest="1" 
            Color="Black" 
            Opacity="0.2" 
            VerticalOptions="Fill" 
            Margin="5,0" />

                        <VerticalStackLayout Grid.Column="4" VerticalOptions="Center" Spacing="4">

                            <HorizontalStackLayout>
                                <Label Text="Líquido: " TextColor="Black" />
                                            <Label Text="{Binding TempoLiquidoFormatado}" FontAttributes="Bold" TextColor="Black" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="Black" Opacity="0.15" HorizontalOptions="Fill" />

                            <HorizontalStackLayout>
                                <Label Text="Bruto: " TextColor="Black" />
                                            <Label Text="{Binding TempoBrutoFormatado}" TextColor="Black" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="Black" Opacity="0.15" HorizontalOptions="Fill" />

                            <HorizontalStackLayout>
                                <Label Text="Pausa: " TextColor="Black" />
                                            <Label Text="{Binding TempoPausaFormatado}" TextColor="Black" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Grid>
                </Border>
                            
                            
            </VerticalStackLayout>
                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>