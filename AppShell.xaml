<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ATHENA.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ATHENA"
    xmlns:metas="clr-namespace:ATHENA.Metas.xaml">

    <Shell.Resources>
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource AthenaBottomBar}" />
            <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource AthenaGoldButton}" />
            <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray500}" />

        </Style>

    </Shell.Resources>

    <TabBar>

        <ShellContent
         Title="Inicio"
         Icon="casa.png"
         ContentTemplate="{DataTemplate local:MainPage}"
         Route="MainPage" />

        <ShellContent
         Title="Meta"
         Icon="seta_de_alvo.png"
         ContentTemplate="{DataTemplate metas:EscolherMeta}"
         Route="EscolherMeta" />

        <ShellContent
         Title="Cronometro"
         Icon="inicio_da_ampulheta.png"
         ContentTemplate="{DataTemplate local:NewPage1}"
         Route="NewPage1" />

    </TabBar>


</Shell>